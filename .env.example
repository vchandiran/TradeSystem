# =============================================================================
# AliceBlue Trading System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control!
# =============================================================================

# AliceBlue Broker Credentials
# Get these from: https://ant.aliceblueonline.com/ -> Apps/API Settings
ALICE_USER_ID=your_user_id_here
ALICE_API_KEY=your_api_key_here

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading Mode: live | paper
TRADING_MODE=paper

# Log Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
